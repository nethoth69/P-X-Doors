# Copy this file to .env and fill in the values you want to use.
# Nothing here is required to run the site — leaving a section blank just
# disables that feature (no order emails, or the admin area stays locked).

PORT=3000

# --- Order email notifications (optional) ---
# Any SMTP provider works — a Gmail account with an "app password" is the
# easiest way to start. Leave these blank to skip email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PX Doors <orders@pxdoors.example>"
NOTIFY_EMAIL=

# --- WhatsApp handoff (optional) ---
# Full international format, digits only, no + or spaces (e.g. 233550000000).
# This only builds a click-to-chat link on the confirmation page and in the
# order email — it does not send WhatsApp messages automatically. Automatic
# WhatsApp messages need Meta's WhatsApp Business Platform, which is a
# separate, approval-based setup.
NOTIFY_WHATSAPP_NUMBER=

# --- Admin area (required to use /admin) ---
# The admin area stays locked (503) until ADMIN_PASSWORD is set.
ADMIN_USER=admin
ADMIN_PASSWORD=
